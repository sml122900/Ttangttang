# scripts/e2e-flow.mjs 용 환경변수. scripts/.env로 복사해서 채울 것
# (커밋 금지 — .gitignore의 `.env` 패턴에 이미 걸린다).
#
# 실행: pnpm e2e
# 스크립트가 모의 토스 서버와 apps/web 개발 서버(next dev)를 직접 띄운다 — 미리 띄울 필요 없음.
# apps/web/.env(Supabase 키)는 채워져 있어야 한다. 진짜 토스로는 요청이 나가지 않는다.

# ---------- Supabase (클라우드 dev 프로젝트 bacwpzlenygqnowvcvnp 기준) ----------
# 대시보드 Settings > API Keys 참고. apps/web/.env의 NEXT_PUBLIC_SUPABASE_* 값과 동일.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# secret key. 테스트 데이터 준비/검증/정리에만 쓴다 — 절대 커밋하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 포트 (선택) ----------
# 스크립트가 띄우는 apps/web 개발 서버 / 모의 토스 서버 포트. 비우면 3100 / 4545.
E2E_WEB_PORT=
E2E_MOCK_TOSS_PORT=

# ---------- 테스트 계정 3개 (판매자/구매자/제3자) ----------
# 실제 카카오 계정이 아니어도 됨 — Supabase Auth에 존재하기만 하면 된다.
# 처음 실행 시 스크립트가 admin API로 자동 생성한다.
E2E_SELLER_EMAIL=e2e-seller@ttangttang.test
E2E_SELLER_PASSWORD=e2e-test-password-1
E2E_BUYER_EMAIL=e2e-buyer@ttangttang.test
E2E_BUYER_PASSWORD=e2e-test-password-2
E2E_OUTSIDER_EMAIL=e2e-outsider@ttangttang.test
E2E_OUTSIDER_PASSWORD=e2e-test-password-3

# ---------- 데모 데이터 (scripts/seed-demo-data.mjs / scripts/cleanup-demo-data.mjs) ----------
# 판매자 1 + 구매자 3(@ttangttang.demo, scripts/lib/demo-data.mjs) 전부 이 비밀번호를 쓴다.
# 폰에서 __DEV__ 이메일 로그인으로 그대로 들어갈 수 있는 값이라 커밋되면 안 된다 — 임의의
# 강한 값으로 채울 것 (docs/phone-check.md는 이 변수명만 언급하고 값은 적지 않는다).
DEMO_SELLER_PASSWORD=
