# scripts/e2e-flow.mjs 용 환경변수. scripts/.env로 복사해서 채울 것
# (커밋 금지 — .gitignore의 `.env` 패턴에 이미 걸린다).
#
# 실행: node --env-file=scripts/.env scripts/e2e-flow.mjs
#   또는: pnpm e2e

# ---------- Supabase (클라우드 프로젝트 bacwpzlenygqnowvcvnp 기준) ----------
# 대시보드 Settings > API Keys 참고. apps/web/.env의 NEXT_PUBLIC_SUPABASE_* 값과 동일.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# secret key. billing_keys에 테스트 빌링키를 직접 넣거나(§2), transactions/items 최종 상태를
# 사용자 세션과 무관하게 검증할 때만 쓴다 — 절대 커밋하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- apps/web 서버 ----------
# SKIP_CHARGE=false로 돌릴 때만 필요 — 3단계(accept API)가 실제로 이 오리진에 POST한다.
# 먼저 `pnpm web:dev`로 띄워둘 것. 미설정 시 http://localhost:3000 사용.
WEB_ORIGIN=http://localhost:3000

# ---------- 결제(charge) 단계 스킵 여부 ----------
# true(기본값): accept API를 호출하지 않는다. 3단계는 판매자의 application 목록 조회까지만
# 검증하고, 4단계(messages RLS)용 transaction은 service role로 직접 만든다. 아래 TOSS_SECRET_KEY/
# TEST_CARD_* 값이 전혀 필요 없다. 실제 결제창 승인·인앱 복귀 확인은 폰 E2E에서 같이 한다.
# false: accept API → 토스 실제 결제(charge) → finalize까지 검증한다. 아래 두 섹션 값이 전부 필요.
SKIP_CHARGE=true

# ---------- (SKIP_CHARGE=false일 때만 필요) Toss Payments 테스트 시크릿 키 ----------
# apps/web/.env의 TOSS_SECRET_KEY(test_sk_...)와 동일한 값. 이 스크립트가 카드정보로 직접
# 테스트 빌링키를 발급받는 데 쓴다(POST /v1/billing/authorizations/card, 실기기 웹뷰 생략).
TOSS_SECRET_KEY=

# ---------- 테스트 계정 3개 (판매자/구매자/제3자) ----------
# 실제 카카오 계정이 아니어도 됨 — apps/mobile의 __DEV__ 이메일/비밀번호 로그인과 동일한 방식으로
# Supabase Auth에 존재하기만 하면 된다. 처음 실행 시 스크립트가 admin API로 자동 생성한다.
E2E_SELLER_EMAIL=e2e-seller@ttangttang.test
E2E_SELLER_PASSWORD=e2e-test-password-1
E2E_BUYER_EMAIL=e2e-buyer@ttangttang.test
E2E_BUYER_PASSWORD=e2e-test-password-2
E2E_OUTSIDER_EMAIL=e2e-outsider@ttangttang.test
E2E_OUTSIDER_PASSWORD=e2e-test-password-3

# ---------- (SKIP_CHARGE=false일 때만 필요) 토스 테스트 카드 정보 ----------
# 실카드 필요 — 기본적으로 사용 안 함 (SKIP_CHARGE=true 기본값에서는 이 값들을 읽지 않는다).
# 토스 공식 문서: "테스트용 국내 카드번호는 없어요" — 빌링(자동결제) 승인 테스트를 하려면
# 실제 발급받은 카드 정보가 필요하다 (test_sk_ 시크릿 키라 실제 출금은 없음). 카드 정보를
# 평문으로 보관하고 싶지 않으면 이 값들은 비워두고 SKIP_CHARGE=true로만 사용할 것 —
# 실제 결제 승인/인앱 복귀 확인은 폰 E2E에서 진행한다.
TEST_CARD_NUMBER=
# YY 2자리(예: 28) 또는 YYYY 4자리 둘 다 가능 — 스크립트가 뒤 2자리로 정규화한다.
TEST_CARD_EXP_YEAR=
# M 또는 MM 둘 다 가능 — 스크립트가 0으로 채워 2자리(MM)로 정규화한다.
TEST_CARD_EXP_MONTH=
TEST_CARD_PASSWORD=
# 생년월일 6자리(YYMMDD) 또는 사업자번호 10자리
TEST_CARD_BIRTH=
