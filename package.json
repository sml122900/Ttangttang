{
  "name": "ttangttang",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "web:dev": "pnpm --filter @ttangttang/web dev",
    "web:build": "pnpm --filter @ttangttang/web build",
    "mobile:dev": "pnpm --filter @ttangttang/mobile start",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "node --env-file=scripts/.env scripts/e2e-flow.mjs",
    "verify:stage3": "node --env-file=scripts/.env scripts/verify-stage3.mjs",
    "verify:stage4": "node --env-file=scripts/.env scripts/verify-stage4.mjs",
    "seed:demo": "node --env-file=scripts/.env scripts/seed-demo-data.mjs",
    "cleanup:demo": "node --env-file=scripts/.env scripts/cleanup-demo-data.mjs"
  }
}
