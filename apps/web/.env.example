# apps/web 용 환경변수. apps/web/.env로 복사해서 채울 것
# (커밋 금지 — .gitignore의 `.env*` 패턴에 이미 걸린다).
#
# Vercel에 배포할 때는 이 파일 대신 Vercel 프로젝트의 Environment Variables에 같은 키를
# 등록한다 (docs/decisions/environment-separation.md 참고).

# ---------- Supabase ----------
# 대시보드 Settings > API Keys. NEXT_PUBLIC_* 두 개는 클라이언트 번들에 포함되므로 반드시
# publishable(anon) 키만 넣을 것 — service_role은 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role — RLS 우회. billing_keys 읽기/쓰기, finalize/revert 호출 등 서버 전용 작업에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 앱 딥링크 ----------
# apps/mobile/app.json의 "scheme"과 동일해야 한다. /pay/billing-done이 카드 등록 결과를
# 돌려보낼 때 기본값으로만 쓰고(세션에 저장된 clientRedirect가 있으면 그쪽을 우선), 실제 값은
# apps/web/lib/billing-session.ts의 appScheme()으로 앱 전역에서 일관되게 사용한다.
NEXT_PUBLIC_APP_SCHEME=ttangttang

# ---------- Toss Payments ----------
# 개발자센터 > 연동 정보. NEXT_PUBLIC_TOSS_CLIENT_KEY는 클라이언트(빌링 SDK)용, TOSS_SECRET_KEY는
# 서버 전용(apps/web/lib/payments/toss.ts에서만 사용, 절대 클라이언트로 넘기지 않는다).
# 테스트 키(test_ck_.../test_sk_...)로 시작 — 라이브 키는 빌링 계약 완료 후 발급받는다(PROJECT.md §4).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------- payment_incidents → Discord 알림 (2단계, docs/decisions.md 참고) ----------
# SUPABASE_WEBHOOK_SECRET: Supabase Database Webhook이 이 값을 x-webhook-secret 헤더로 보내도록
# 설정한다 (openssl rand -hex 32 등으로 생성). 비어 있으면 /api/webhooks/payment-incident가
# 아무 요청도 처리하지 않고 200만 반환한다(안전한 기본값).
# DISCORD_WEBHOOK_URL: 알림을 받을 디스코드 채널의 웹훅 URL. 비어 있으면 로그만 남기고 스킵한다.
SUPABASE_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=

# ---------- 카카오 로컬 API (3단계 온보딩 동네 설정) ----------
# Kakao Developers 앱의 REST API 키 — supabase/.env의 SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID와
# 같은 값이다(카카오는 하나의 REST API 키로 로그인과 로컬 API를 겸한다). 카카오 개발자센터에서
# 해당 앱에 "카카오맵/로컬" 사용 설정이 켜져 있어야 한다 — apps/web/lib/kakao-local.ts에서만 쓴다.
KAKAO_REST_API_KEY=

# ---------- 토스 API 오버라이드 (선택, 보통 비워둔다) ----------
# scripts/e2e-flow.mjs가 모의 토스 서버를 띄울 때만 TOSS_API_BASE를 설정해 실제 토스 대신
# 그 서버를 가리키게 한다 (apps/web/lib/payments/toss.ts). 운영 환경에서는 비워둘 것 —
# 비어 있으면 기본값(https://api.tosspayments.com/v1)을 쓴다.
# TOSS_TIMEOUT_MS는 결제 요청 타임아웃(ms) — 비어 있으면 10000.
TOSS_API_BASE=
TOSS_TIMEOUT_MS=
